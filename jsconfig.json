{
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": ".",
    "checkJs": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@/*": ["src/*"]
    },
    "skipLibCheck": true,
    "target": "ES2022"
  },
  "include": ["src/lib/**/*.js", "src/utils/**/*.ts", "vite.config.js"],
  "exclude": ["node_modules", "dist"]
}
