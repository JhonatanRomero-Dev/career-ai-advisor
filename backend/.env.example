PORT=3000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300
SHUTDOWN_TIMEOUT_MS=10000

AI_PROVIDER=auto
AI_TIMEOUT_MS=45000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AUTH_CODE_SECRET=
ANALYTICS_HASH_SECRET=
OAUTH_STATE_SECRET=
AUTH_COOKIE_NAME=career_ai_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_RETURN_TOKEN_IN_RESPONSE=false
CSRF_COOKIE_NAME=career_ai_csrf
ADMIN_EMAILS=
ADMIN_USER_IDS=
ALLOW_DEMO_CHECKOUT=false
ALLOW_DEV_EMAIL_FALLBACK=false
EXPOSE_DEV_AUTH_CODE=false
DEV_AUTH_TEST_EMAIL=
DEMO_EMAIL_LOGIN=false
FRONTEND_DIST_PATH=
ASYNC_ANALYSIS_JOBS=false
DATABASE_URL=
DATABASE_PROVIDER=sqlite
SQLITE_DB_PATH=

# Real vacancies. Remotive returns active remote ads; the app keeps only
# listings that explicitly accept candidates located in Brazil.
JOBS_PROVIDER=auto
JOBS_API_TIMEOUT_MS=12000
JOBS_MAX_RESULTS=16
# Optional Brazilian listings provider. Register at developer.adzuna.com.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Resume source text privacy.
# auto encrypts when RESUME_TEXT_ENCRYPTION_KEY or AUTH_CODE_SECRET exists.
# Use off in production if you do not need improved-resume generation from saved analyses.
RESUME_TEXT_STORAGE=auto
RESUME_TEXT_ENCRYPTION_KEY=
RESUME_TEXT_RETENTION_DAYS=

# Payment gateway. Use a TEST token for sandbox checkout.
PAYMENT_GATEWAY=mercadopago
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_ALLOW_UNSIGNED_WEBHOOKS=false
MERCADO_PAGO_USE_SANDBOX=true
BACKEND_PUBLIC_URL=http://localhost:3000
MERCADO_PAGO_NOTIFICATION_URL=
# Configure os eventos payment, subscription_preapproval e
# subscription_authorized_payment no painel de Webhooks do Mercado Pago.

# SMTP settings. Configure these before testing with real users.
# Keep ALLOW_DEV_EMAIL_FALLBACK=false so verification codes only arrive by email.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TEST_TO=

# Optional OAuth credentials.
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub callback: http://localhost:3000/api/auth/oauth/github/callback
GOOGLE_CLIENT_SECRET=
# LinkedIn callback URL for local development:
# http://localhost:3000/api/auth/oauth/linkedin/callback
# Enable the "Sign In with LinkedIn using OpenID Connect" product in the app.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:3000
